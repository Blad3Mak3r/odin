# Odin system-wide configuration (installed by the .deb/.rpm package).
# Uncomment to override the data directory (default: /var/lib/odin).
# data_dir = "/var/lib/odin"

# Podman is required only when operating Valheim. Odin can run without this
# configuration, but Valheim actions remain unavailable until it is set.
# The root service uses the rootful Podman socket by default.
# [podman]
# socket = "/run/podman/podman.sock"
# Optional image overrides. `runtime_image` remains a deprecated alias for
# `base_image`; keep moving `:base`/`:proton` tags unless deliberately pinning.
# base_image = "ghcr.io/blad3mak3r/odin-srv:base"
# proton_image = "ghcr.io/blad3mak3r/odin-srv:proton"
# odin_binary = "/usr/bin/odin"
