/target
/dist

# Dashboard frontend build artifacts. web/dist/index.html is intentionally
# tracked as a placeholder so a bare `cargo build` still compiles (rust-embed
# needs web/dist/ to exist) before `make web-build` has ever been run.
/web/node_modules
/web/dist/*
!/web/dist/index.html

# Impeccable design-skill machine-local overrides (e.g. hook consent);
# .impeccable/design.json (the design-system sidecar) is tracked.
/.impeccable/config.local.json

# Claude Code agent tooling: local settings, git worktrees created by the
# agent, downloaded skill caches, and their lock file. Machine-local, not
# project state.
/.claude/
/.agents/
/skills-lock.json
