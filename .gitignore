/target
/dist

# Dashboard frontend build artifacts. Keep only the sentinel that lets
# rust-embed find web/dist/ before the frontend has been built.
/web/node_modules
/web/dist/*
!/web/dist/.gitkeep

# Impeccable design-skill machine-local overrides (e.g. hook consent);
# .impeccable/design.json (the design-system sidecar) is tracked.
/.impeccable/config.local.json

# Claude Code agent tooling: local settings, git worktrees created by the
# agent, downloaded skill caches, and their lock file. Machine-local, not
# project state. Project sub-agent definitions in .claude/agents/ are tracked.
/.claude/*
!/.claude/agents/
/.agents/
/skills-lock.json

# Local secrets (e.g. CURSE_FORGE_API_KEY for development)
.env
